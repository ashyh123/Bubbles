# Copy to a local file and fill in. Do not commit real keys.
# BUBBLE_API_KEY and DEEPSEEK_API_KEY are aliases; set one of them.
# If neither is set, bubble prints: 缺少 DEEPSEEK_API_KEY，请参考 .env.example 配置
BUBBLE_API_KEY=
DEEPSEEK_API_KEY=
BUBBLE_BASE_URL=https://api.deepseek.com
BUBBLE_MODEL=deepseek-chat
BUBBLE_REASONING_EFFORT=low
BUBBLE_TIMEOUT=45
# BUBBLE_TASTE_PATH=~/.bubble/taste.md
